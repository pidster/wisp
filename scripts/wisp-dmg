#!/bin/sh
# Pack Wisp.app into a compressed disk image (ADR 0072): the app, a link to /Applications to drag it onto, and a short
# read-me. Signed with the Developer ID named by WISP_SIGN_IDENTITY when it is set; the release then notarises and
# staples it.
# Usage: scripts/wisp-dmg <Wisp.app> <destination .dmg> <version>
set -eu

[ "$#" -eq 3 ] || { echo "usage: scripts/wisp-dmg <Wisp.app> <destination .dmg> <version>" >&2; exit 64; }
APP="$1"
DMG="$2"
VERSION="$3"
[ -d "$APP/Contents/MacOS" ] || { echo "no app at $APP" >&2; exit 1; }

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
CONTENT="$WORK/Wisp $VERSION"
mkdir "$CONTENT"
ditto "$APP" "$CONTENT/Wisp.app"
ln -s /Applications "$CONTENT/Applications"
cat > "$CONTENT/Read Me.txt" <<README
Wisp $VERSION

1. Drag Wisp.app onto Applications.
2. Open Wisp.app there and choose Install, or in a terminal run:

     /Applications/Wisp.app/Contents/MacOS/wisp install

   It links wisp and wisp-tui into ~/.local/bin, and says what to add to your
   shell's start-up file if that folder is not on your PATH.
3. In a new terminal, run: wisp doctor

wisp keeps its state in ~/.wisp, shared with a Homebrew install of wisp.
Documentation: https://wisp.pidster.com/docs/
README
rm -f "$DMG"
hdiutil create -quiet -volname "Wisp $VERSION" -srcfolder "$CONTENT" -fs APFS -format UDZO "$DMG"
if [ -n "${WISP_SIGN_IDENTITY:-}" ]; then
    codesign --force --timestamp --sign "$WISP_SIGN_IDENTITY" "$DMG"
    codesign --verify --strict "$DMG"
fi
hdiutil verify -quiet "$DMG"
printf '%s\n' "$DMG"

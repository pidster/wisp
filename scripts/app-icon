#!/bin/sh
# Build an .icns from a square PNG of at least 1024 pixels: every size macOS asks for, by sips, packed by iconutil.
# The .icns is built at packaging time rather than committed, being over the gate's limit for a committed file
# (ADR 0070). Used by scripts/notifier-app and scripts/wisp-app.
# Usage: scripts/app-icon <source PNG> <destination .icns>
set -eu

[ "$#" -eq 2 ] || { echo "usage: scripts/app-icon <source PNG> <destination .icns>" >&2; exit 64; }
SOURCE="$1"
DESTINATION="$2"
[ -f "$SOURCE" ] || { echo "no icon source at $SOURCE" >&2; exit 1; }
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
mkdir "$WORK/AppIcon.iconset"
for size in 16 32 128 256 512; do
    sips -z "$size" "$size" "$SOURCE" --out "$WORK/AppIcon.iconset/icon_${size}x${size}.png" >/dev/null
    sips -z "$((size * 2))" "$((size * 2))" "$SOURCE" --out "$WORK/AppIcon.iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$WORK/AppIcon.iconset" -o "$DESTINATION"

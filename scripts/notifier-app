#!/bin/sh
# Wrap the WispNotifier executable in Wisp Notifier.app (ADR 0070) and sign it: with the Developer ID named by
# WISP_SIGN_IDENTITY when it is set (hardened runtime, secure timestamp), ad hoc otherwise, which seals the
# Info.plist and the icon with the executable. The icon is built here, by scripts/app-icon, from
# harness/Notifier/AppIcon-1024.png, the committed source (ADR 0070 says how it was made).
# Usage: scripts/notifier-app <WispNotifier executable> <directory to put the bundle in> <version>
# The release runs it on the stripped release build; for a debug build beside harness/.build/debug/wisp:
#   scripts/notifier-app harness/.build/debug/WispNotifier harness/.build/debug 0.0.0
set -eu

[ "$#" -eq 3 ] || { echo "usage: scripts/notifier-app <WispNotifier executable> <directory> <version>" >&2; exit 64; }
EXECUTABLE="$1"
DIRECTORY="$2"
VERSION="$3"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ICON_SOURCE="$ROOT/harness/Notifier/AppIcon-1024.png"
[ -x "$EXECUTABLE" ] || { echo "no executable at $EXECUTABLE (swift build --product WispNotifier)" >&2; exit 1; }
[ -d "$DIRECTORY" ] || { echo "no directory $DIRECTORY" >&2; exit 1; }
[ -f "$ICON_SOURCE" ] || { echo "no icon source at $ICON_SOURCE" >&2; exit 1; }

APP="$DIRECTORY/Wisp Notifier.app"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$EXECUTABLE" "$APP/Contents/MacOS/WispNotifier"
"$ROOT/scripts/app-icon" "$ICON_SOURCE" "$APP/Contents/Resources/AppIcon.icns"
# LSUIElement: no Dock icon and no menu bar; the bundle identifier is permanent, since macOS keeps the person's
# permission under it.
cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.pidster.wisp.notifier</string>
    <key>CFBundleName</key>
    <string>Wisp</string>
    <key>CFBundleDisplayName</key>
    <string>Wisp</string>
    <key>CFBundleExecutable</key>
    <string>WispNotifier</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$VERSION</string>
    <key>CFBundleVersion</key>
    <string>$VERSION</string>
    <key>LSMinimumSystemVersion</key>
    <string>27.0</string>
    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
PLIST
plutil -lint -s "$APP/Contents/Info.plist"
if [ -n "${WISP_SIGN_IDENTITY:-}" ]; then
    codesign --force --options runtime --timestamp --sign "$WISP_SIGN_IDENTITY" "$APP"
else
    codesign --force --sign - "$APP"
fi
codesign --verify --strict "$APP"
printf '%s\n' "$APP"

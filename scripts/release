#!/bin/sh
# Cut a release: preflight, build, package, tag, GitHub release, Homebrew tap formula.
# Usage: scripts/release X.Y.Z [--dry-run] [--skip-eval]
# See docs/release.md. Remote steps (tag push, release, tap push) are printed, not run, with --dry-run.
# --skip-eval leaves out the model eval, for a release whose eval already passed on the same code (a dry
# run just before, with only docs changed since); say so in the release notes or the commit that follows.
set -eu

VERSION="${1:-}"
[ -n "$VERSION" ] || { echo "usage: scripts/release X.Y.Z [--dry-run] [--skip-eval]" >&2; exit 64; }
case "$VERSION" in *[!0-9.]*|.*|*.|*..*) echo "version must be X.Y.Z" >&2; exit 64 ;; esac
shift
DRY_RUN=""
SKIP_EVAL=""
for flag in "$@"; do
    case "$flag" in
        --dry-run) DRY_RUN="--dry-run" ;;
        --skip-eval) SKIP_EVAL=1 ;;
        *) echo "unknown flag $flag" >&2; exit 64 ;;
    esac
done

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
TAG="v$VERSION"
TARBALL="wisp-$VERSION-arm64.tar.gz"
TAP_REPO="pidster/homebrew-tap"
OUT="$ROOT/harness/.build/release-artifacts"

remote() {
    if [ "$DRY_RUN" = "--dry-run" ]; then
        echo "[dry-run] $*"
    else
        "$@"
    fi
}

echo "==> preflight"
missing=""
for page in docs/*.md docs/decisions/*.md docs/proposals/*.md docs/tools/*.md; do
    case "$page" in docs/README.md|docs/tools/README.md) continue ;; esac
    name="${page#docs/}"
    index=docs/README.md
    case "$page" in docs/tools/*) index=docs/tools/README.md; name="${page#docs/tools/}" ;; esac
    grep -q "($name)" "$index" || missing="$missing $page"
done
[ -z "$missing" ] || { echo "not in the docs index:$missing (see docs/release.md, step 0)" >&2; exit 1; }
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || { echo "not on main" >&2; exit 1; }
[ -z "$(git status --porcelain)" ] || { echo "working tree not clean" >&2; exit 1; }
START="$(git rev-parse HEAD)"
# The binary is built from the working tree, so the tree and HEAD must stay as preflight found them
# until the release is published: 0.13.0 shipped an edit made while its evals ran.
unchanged() {
    [ "$(git rev-parse HEAD)" = "$START" ] || { echo "HEAD moved during the release ($START to $(git rev-parse HEAD)); rerun" >&2; exit 1; }
    [ -z "$(git status --porcelain)" ] || { echo "the working tree changed during the release; the build would not match $TAG:" >&2; git status --short >&2; exit 1; }
}
grep -q "^version = \"$VERSION\"" tools/wisp-tui/Cargo.toml || { echo "tools/wisp-tui/Cargo.toml version is not $VERSION" >&2; exit 1; }
command -v cargo >/dev/null || { echo "cargo is needed to build wisp-tui" >&2; exit 1; }
CURRENT="$(sed -n 's/.*public static let current = "\([^"]*\)".*/\1/p' harness/Sources/WispCore/Audit/AuditEvent.swift)"
[ "$CURRENT" = "$VERSION" ] || { echo "WispVersion.current is $CURRENT, not $VERSION; bump it first" >&2; exit 1; }
SHIPPED="$(sed -n 's/^ *"version" : "\([^"]*\)",*$/\1/p' harness/Sources/WispCore/Resources/risk-default.json | head -1)"
[ "$SHIPPED" = "$VERSION-default" ] || { echo "the shipped classifier is $SHIPPED, not $VERSION-default; run scripts/check classifier-default after the bump" >&2; exit 1; }
if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then echo "tag $TAG exists" >&2; exit 1; fi
gh auth status >/dev/null 2>&1 || { echo "gh is not authenticated" >&2; exit 1; }
NOTES="$(awk -v v="$VERSION" '
    $0 == "## " v { on = 1; next }
    /^## / { on = 0 }
    on { print }
' CHANGELOG.md | sed -e '/./,$!d')"
[ -n "$NOTES" ] || { echo "CHANGELOG.md has no section '## $VERSION'; write the release notes first" >&2; exit 1; }
scripts/check all
scripts/check coverage-gate
if [ -n "$SKIP_EVAL" ]; then
    echo "==> eval skipped (--skip-eval): it must have passed on this code already" >&2
else
    scripts/check eval
fi
if [ -n "$(git status --porcelain harness/Sources/WispCore/Resources/measurements.json)" ]; then
    echo "the eval changed harness/Sources/WispCore/Resources/measurements.json; commit it (the binary must carry the numbers that are committed) and rerun" >&2
    exit 1
fi

echo "==> build"
unchanged
(cd harness && swift build -c release)
(cd tools && cargo build --release -q -p wisp-tui)
BIN="harness/.build/release/wisp"
TUI="tools/target/release/wisp-tui"
rm -rf "$OUT"; mkdir -p "$OUT/stage"
cp "$BIN" "$OUT/stage/wisp"
cp "$TUI" "$OUT/stage/wisp-tui"
strip "$OUT/stage/wisp" "$OUT/stage/wisp-tui"
cp LICENSE "$OUT/stage/LICENSE"
[ "$("$OUT/stage/wisp" --version)" = "$VERSION" ] || { echo "built binary reports $("$OUT/stage/wisp" --version)" >&2; exit 1; }
[ "$("$OUT/stage/wisp-tui" --version)" = "$VERSION" ] || { echo "wisp-tui reports $("$OUT/stage/wisp-tui" --version); set version in tools/wisp-tui/Cargo.toml" >&2; exit 1; }
"$OUT/stage/wisp" doctor

echo "==> package"
{
    printf '%s\n\n' "$NOTES"
    printf 'Install or upgrade with Homebrew: `brew install pidster/tap/wisp`. Downloading the tarball directly leaves it quarantined; use Homebrew.\n'
} > "$OUT/notes.md"
(cd "$OUT/stage" && tar -czf "../$TARBALL" wisp wisp-tui LICENSE)
(cd "$OUT" && shasum -a 256 "$TARBALL" > "$TARBALL.sha256")
SHA="$(cut -d' ' -f1 "$OUT/$TARBALL.sha256")"
ls -la "$OUT/$TARBALL"; echo "sha256 $SHA"

echo "==> publish"
unchanged
remote git tag -a "$TAG" -m "wisp $VERSION"
remote git push origin "$TAG"
remote gh release create "$TAG" "$OUT/$TARBALL" "$OUT/$TARBALL.sha256" --title "wisp $VERSION" \
    --notes-file "$OUT/notes.md"

echo "==> tap formula"
FORMULA="$OUT/wisp.rb"
cat > "$FORMULA" <<RUBY
class Wisp < Formula
  desc "On-device, tool-using AI microharness for macOS"
  homepage "https://github.com/pidster/wisp"
  url "https://github.com/pidster/wisp/releases/download/$TAG/$TARBALL"
  sha256 "$SHA"
  license "MIT"
  version "$VERSION"

  depends_on arch: :arm64
  depends_on macos: :golden_gate

  def install
    bin.install "wisp", "wisp-tui"
  end

  test do
    assert_equal "$VERSION", shell_output("#{bin}/wisp --version").strip
    assert_equal "$VERSION", shell_output("#{bin}/wisp-tui --version").strip
  end
end
RUBY
echo "formula written to $FORMULA"
TAP_DIR="$OUT/tap"
remote sh -c "rm -rf '$TAP_DIR' && gh repo clone $TAP_REPO '$TAP_DIR' && mkdir -p '$TAP_DIR/Formula' && cp '$FORMULA' '$TAP_DIR/Formula/wisp.rb' && cd '$TAP_DIR' && git add Formula/wisp.rb && git commit -m 'wisp $VERSION' && git push"

echo "==> done"
echo "verify: brew update && brew install pidster/tap/wisp && wisp doctor"

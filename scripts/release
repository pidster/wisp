#!/bin/sh
# Cut a release: preflight, build, package, tag, GitHub release, Homebrew tap formula.
# Usage: scripts/release X.Y.Z [--dry-run] [--skip-eval] [--unsigned]
# See docs/release.md. Remote steps (tag push, release, tap push) are printed, not run, with --dry-run.
# --skip-eval leaves out the model eval, for a release whose eval already passed on the same code (a dry
# run just before, with only docs changed since); say so in the release notes or the commit that follows.
# The release is signed with a Developer ID and notarised (ADR 0069, by default since ADR 0071): wisp, wisp-tui, and
# Wisp Notifier.app, signed by the identity WISP_SIGN_IDENTITY names (a full or unique partial name from
# `security find-identity -v -p codesigning`; default "Developer ID Application", the one such identity in the
# keychain) and notarised with the notarytool keychain profile WISP_NOTARY_PROFILE (default wisp-notary).
# --unsigned leaves them with the linker's ad hoc signature, as releases before 0.30.1 were.
set -eu

VERSION="${1:-}"
[ -n "$VERSION" ] || { echo "usage: scripts/release X.Y.Z [--dry-run] [--skip-eval] [--unsigned]" >&2; exit 64; }
# Exactly three dot-separated numbers: 1.2 or 1.2.3.4 would tag a version Homebrew and WispVersion disagree on.
printf '%s\n' "$VERSION" | grep -Eqx '(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)' \
    || { echo "version must be X.Y.Z (three numbers, no leading zeros), not '$VERSION'" >&2; exit 64; }
shift
DRY_RUN=""
SKIP_EVAL=""
UNSIGNED=""
for flag in "$@"; do
    case "$flag" in
        --dry-run) DRY_RUN="--dry-run" ;;
        --skip-eval) SKIP_EVAL=1 ;;
        --unsigned) UNSIGNED=1 ;;
        *) echo "unknown flag $flag" >&2; exit 64 ;;
    esac
done

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
TAG="v$VERSION"
TARBALL="wisp-$VERSION-arm64.tar.gz"
DMG="Wisp-$VERSION.dmg"
TAP_REPO="pidster/homebrew-tap"
OUT="$ROOT/harness/.build/release-artifacts"
SIGN_IDENTITY="${WISP_SIGN_IDENTITY:-Developer ID Application}"
[ -z "$UNSIGNED" ] || SIGN_IDENTITY=""
NOTARY_PROFILE="${WISP_NOTARY_PROFILE:-wisp-notary}"

remote() {
    if [ "$DRY_RUN" = "--dry-run" ]; then
        echo "[dry-run] $*"
    else
        "$@"
    fi
}

echo "==> preflight"
missing=""
for page in docs/*.md docs/decisions/*.md docs/proposals/*.md docs/tools/*.md; do
    # SUMMARY.md is the site's table of contents, not a page; scripts/check docs-links checks it (ADR 0065).
    case "$page" in docs/README.md|docs/tools/README.md|docs/SUMMARY.md) continue ;; esac
    name="${page#docs/}"
    index=docs/README.md
    case "$page" in docs/tools/*) index=docs/tools/README.md; name="${page#docs/tools/}" ;; esac
    grep -q "($name)" "$index" || missing="$missing $page"
done
[ -z "$missing" ] || { echo "not in the docs index:$missing (see docs/release.md, step 0)" >&2; exit 1; }
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || { echo "not on main" >&2; exit 1; }
[ -z "$(git status --porcelain)" ] || { echo "working tree not clean" >&2; exit 1; }
START="$(git rev-parse HEAD)"
# The binary is built from the working tree, so the tree and HEAD must stay as preflight found them
# until the release is published: 0.13.0 shipped an edit made while its evals ran.
unchanged() {
    [ "$(git rev-parse HEAD)" = "$START" ] || { echo "HEAD moved during the release ($START to $(git rev-parse HEAD)); rerun" >&2; exit 1; }
    [ -z "$(git status --porcelain)" ] || { echo "the working tree changed during the release; the build would not match $TAG:" >&2; git status --short >&2; exit 1; }
}
grep -q "^version = \"$VERSION\"" tools/wisp-tui/Cargo.toml || { echo "tools/wisp-tui/Cargo.toml version is not $VERSION" >&2; exit 1; }
command -v cargo >/dev/null || { echo "cargo is needed to build wisp-tui" >&2; exit 1; }
# The Metal toolchain, by compiling a one-line kernel: `xcrun -f metal` finds Xcode's stub even when the toolchain, a
# separate download, is missing (an Xcode update drops it), and 0.26.3's first run then failed at the MLX build, after
# the whole test run.
METAL_PROBE="$(mktemp -d)"
printf '%s\n' 'kernel void probe(device float *a [[buffer(0)]]) { a[0] = 1; }' >"$METAL_PROBE/probe.metal"
if ! xcrun metal -c "$METAL_PROBE/probe.metal" -o "$METAL_PROBE/probe.air" >/dev/null 2>&1; then
    rm -rf "$METAL_PROBE"
    echo "the Metal toolchain is needed to build MLX and cannot compile: xcodebuild -downloadComponent MetalToolchain" >&2
    exit 1
fi
rm -rf "$METAL_PROBE"
CURRENT="$(sed -n 's/.*public static let current = "\([^"]*\)".*/\1/p' harness/Sources/WispCore/Audit/AuditEvent.swift)"
[ "$CURRENT" = "$VERSION" ] || { echo "WispVersion.current is $CURRENT, not $VERSION; bump it first" >&2; exit 1; }
SHIPPED="$(sed -n 's/^ *"version" : "\([^"]*\)",*$/\1/p' harness/Sources/WispCore/Resources/risk-default.json | head -1)"
[ "$SHIPPED" = "$VERSION-default" ] || { echo "the shipped classifier is $SHIPPED, not $VERSION-default; run scripts/check classifier-default after the bump" >&2; exit 1; }
if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then echo "tag $TAG exists" >&2; exit 1; fi
gh auth status >/dev/null 2>&1 || { echo "gh is not authenticated" >&2; exit 1; }
# Signing, before the slow steps: exactly one Developer ID identity matching the name, and a notary profile that
# signs in to Apple (history reads the team's submissions and changes nothing).
if [ -n "$SIGN_IDENTITY" ]; then
    case "$SIGN_IDENTITY" in
        "Developer ID Application"*) ;;
        *) echo "WISP_SIGN_IDENTITY must name a Developer ID Application identity, not '$SIGN_IDENTITY'" >&2; exit 1 ;;
    esac
    matches="$(security find-identity -v -p codesigning | grep -cF "\"$SIGN_IDENTITY" || true)"
    [ "$matches" -eq 1 ] || { echo "$matches valid signing identities match '$SIGN_IDENTITY'; need exactly one: name it with WISP_SIGN_IDENTITY, or release with --unsigned (security find-identity -v -p codesigning; docs/release.md, \"Signing\")" >&2; exit 1; }
    xcrun notarytool history --keychain-profile "$NOTARY_PROFILE" >/dev/null 2>&1 \
        || { echo "notarytool cannot sign in with the keychain profile '$NOTARY_PROFILE' (docs/release.md, \"Signing\")" >&2; exit 1; }
    echo "signing as $SIGN_IDENTITY, notarising with the profile $NOTARY_PROFILE"
else
    echo "unsigned: --unsigned was given (docs/release.md, \"Signing\")"
fi
# The remote, read only, before the slow steps: the tag must not exist on origin (a local check misses one pushed
# from another clone), and origin/main must be HEAD, so the tag names a commit that is pushed and nothing on origin is
# left out. A dry run, often made before pushing, reports these and goes on.
remote_problem() {
    if [ "$DRY_RUN" = "--dry-run" ]; then
        echo "[dry-run] would stop here: $*" >&2
    else
        echo "$*" >&2
        exit 1
    fi
}
if remote_tag="$(git ls-remote --tags origin "refs/tags/$TAG")"; then
    [ -z "$remote_tag" ] || remote_problem "tag $TAG exists on origin"
else
    remote_problem "could not ask origin for its tags (git ls-remote failed)"
fi
if remote_main="$(git ls-remote origin refs/heads/main | cut -f1)" && [ -n "$remote_main" ]; then
    if [ "$remote_main" != "$START" ]; then
        if git merge-base --is-ancestor "$remote_main" "$START" 2>/dev/null; then
            remote_problem "main is not pushed: origin/main is $remote_main, HEAD is $START; push it first"
        else
            remote_problem "main is behind or has diverged from origin/main ($remote_main); pull, check, and rerun"
        fi
    fi
else
    remote_problem "could not read origin's main (git ls-remote failed)"
fi
NOTES="$(awk -v v="$VERSION" '
    $0 == "## " v { on = 1; next }
    /^## / { on = 0 }
    on { print }
' CHANGELOG.md | sed -e '/./,$!d')"
[ -n "$NOTES" ] || { echo "CHANGELOG.md has no section '## $VERSION'; write the release notes first" >&2; exit 1; }
scripts/check all
# The code only the MLX trait compiles, with its tests, warnings as errors: the release build below is the first
# build of it otherwise, and a failure there comes after the eval's hour.
scripts/check mlx-build
scripts/check coverage-gate
if [ -n "$SKIP_EVAL" ]; then
    echo "==> eval skipped (--skip-eval): it must have passed on this code already" >&2
else
    scripts/check eval
fi
if [ -n "$(git status --porcelain harness/Sources/WispCore/Resources/measurements.json)" ]; then
    echo "the eval changed harness/Sources/WispCore/Resources/measurements.json; commit it (the binary must carry the numbers that are committed) and rerun" >&2
    exit 1
fi

echo "==> build"
unchanged
# With MLX (ADR 0047): MLX loads its Metal library at run time, first as mlx.metallib beside the binary.
# WISP_RELEASE=1 makes --version print the bare version (the build plugin reads it).
(cd harness && WISP_RELEASE=1 swift build -c release --traits MLX)
(cd tools && WISP_RELEASE=1 cargo build --release -q -p wisp-tui)
BIN_DIR="$(cd harness && WISP_RELEASE=1 swift build -c release --traits MLX --show-bin-path)"
BIN="$BIN_DIR/wisp"
TUI="tools/target/release/wisp-tui"
METALLIB=""
for candidate in "$BIN_DIR/mlx-swift_Cmlx.bundle/Contents/Resources/default.metallib" \
    "$BIN_DIR/mlx-swift_Cmlx.bundle/default.metallib"; do
    if [ -f "$candidate" ]; then METALLIB="$candidate"; break; fi
done
[ -n "$METALLIB" ] || { echo "no default.metallib in $BIN_DIR/mlx-swift_Cmlx.bundle; was MLX built?" >&2; exit 1; }
rm -rf "$OUT"; mkdir -p "$OUT/stage"
cp "$BIN" "$OUT/stage/wisp"
cp "$TUI" "$OUT/stage/wisp-tui"
cp "$METALLIB" "$OUT/stage/mlx.metallib"
strip "$OUT/stage/wisp" "$OUT/stage/wisp-tui"
# Signed after strip, which would invalidate a signature, and before the checks below, so they run the signed
# binaries: the hardened runtime, with no entitlements, and Apple's secure timestamp, so a signature outlives the
# certificate (ADR 0069).
if [ -n "$SIGN_IDENTITY" ]; then
    for exe in wisp wisp-tui; do
        codesign --force --options runtime --timestamp --sign "$SIGN_IDENTITY" "$OUT/stage/$exe"
        codesign --verify --strict "$OUT/stage/$exe"
    done
fi
# Wisp Notifier.app (ADR 0070): the release build's WispNotifier, stripped, wrapped in the bundle with its icon, and
# signed by scripts/notifier-app, with the same identity as the binaries or ad hoc.
cp "$BIN_DIR/WispNotifier" "$OUT/WispNotifier"
strip "$OUT/WispNotifier"
WISP_SIGN_IDENTITY="$SIGN_IDENTITY" scripts/notifier-app "$OUT/WispNotifier" "$OUT/stage" "$VERSION" >/dev/null
rm "$OUT/WispNotifier"
[ "$(plutil -extract CFBundleShortVersionString raw -o - "$OUT/stage/Wisp Notifier.app/Contents/Info.plist")" = "$VERSION" ] \
    || { echo "Wisp Notifier.app's version is not $VERSION" >&2; exit 1; }
cp LICENSE "$OUT/stage/LICENSE"
[ "$("$OUT/stage/wisp" --version)" = "$VERSION" ] || { echo "built binary reports $("$OUT/stage/wisp" --version)" >&2; exit 1; }
[ "$("$OUT/stage/wisp-tui" --version)" = "$VERSION" ] || { echo "wisp-tui reports $("$OUT/stage/wisp-tui" --version); set version in tools/wisp-tui/Cargo.toml" >&2; exit 1; }
"$OUT/stage/wisp" doctor
# The staged binary, away from the build's bundle, must find the staged library.
STAGE_REAL="$(cd "$OUT/stage" && pwd -P)"
"$OUT/stage/wisp" doctor | grep -qxF "ok   MLX: Metal library $STAGE_REAL/mlx.metallib loads" \
    || { echo "the staged wisp does not load the staged mlx.metallib (wisp doctor's MLX finding)" >&2; exit 1; }
# And find the staged helper beside it (the notifier finding names it with its permission on this Mac).
"$OUT/stage/wisp" doctor | grep -qF "ok   notifier: $STAGE_REAL/Wisp Notifier.app" \
    || { echo "the staged wisp does not find the staged Wisp Notifier.app (wisp doctor's notifier finding)" >&2; exit 1; }
# The formula installs the completions from 'wisp completions <shell>'; the staged binary must print the committed ones.
for entry in zsh:_wisp bash:wisp.bash fish:wisp.fish; do
    "$OUT/stage/wisp" completions "${entry%%:*}" | cmp -s - "harness/Sources/WispCore/Resources/completions/${entry#*:}" \
        || { echo "the staged wisp's ${entry%%:*} completions differ from the committed ${entry#*:}" >&2; exit 1; }
done
# Wisp.app, for the DMG (ADR 0072), from the same staged and signed parts; a signed release only, since an app
# signed ad hoc and downloaded directly is refused by Gatekeeper.
if [ -n "$SIGN_IDENTITY" ]; then
    echo "==> Wisp.app"
    WISP_SIGN_IDENTITY="$SIGN_IDENTITY" scripts/wisp-app "$OUT/stage" "$OUT" "$VERSION" >/dev/null
    APP_REAL="$(cd "$OUT/Wisp.app" && pwd -P)"
    # Every part the app declares is present, and wisp started through a link outside the app, as a PATH entry
    # starts it, still finds MLX's library in the app's resources.
    "$OUT/Wisp.app/Contents/MacOS/wisp" doctor | grep -qxF \
        "ok   package: $APP_REAL/Contents/Info.plist declares wisp-tui, Wisp Notifier.app, the Metal library; all present" \
        || { echo "Wisp.app's wisp doctor does not find every declared part (its package finding)" >&2; exit 1; }
    rm -rf "$OUT/link"; mkdir "$OUT/link"; ln -s "$APP_REAL/Contents/MacOS/wisp" "$OUT/link/wisp"
    "$OUT/link/wisp" doctor | grep -qxF \
        "ok   MLX: Metal library $APP_REAL/Contents/Resources/mlx-swift_Cmlx.bundle/default.metallib loads" \
        || { echo "wisp started through a link does not load Wisp.app's Metal library (wisp doctor's MLX finding)" >&2; exit 1; }
    rm -rf "$OUT/link"
fi

if [ -n "$SIGN_IDENTITY" ]; then
    echo "==> notarise"
    # Submits one file to Apple's notary service and waits; the release stops, with the submission's log, unless Apple
    # accepts it.
    notarise() {
        if [ "$DRY_RUN" = "--dry-run" ]; then
            echo "[dry-run] xcrun notarytool submit $1 --keychain-profile $NOTARY_PROFILE --wait"
            return 0
        fi
        submitted="$(xcrun notarytool submit "$1" --keychain-profile "$NOTARY_PROFILE" --wait \
            --timeout 30m --output-format json)" || true
        verdict="$(printf '%s' "$submitted" | plutil -extract status raw -o - - 2>/dev/null || true)"
        submission="$(printf '%s' "$submitted" | plutil -extract id raw -o - - 2>/dev/null || true)"
        if [ "$verdict" != "Accepted" ]; then
            printf '%s\n' "notarisation of ${1##*/} ended '${verdict:-without a verdict}': $submitted" >&2
            [ -z "$submission" ] || xcrun notarytool log "$submission" --keychain-profile "$NOTARY_PROFILE" >&2 || true
            exit 1
        fi
        echo "notarised ${1##*/}: submission $submission accepted"
    }
    # The two signed binaries, the helper bundle, and Wisp.app, zipped, in one submission. A bare executable cannot
    # carry a stapled ticket, so Gatekeeper fetches its ticket online the first time it meets one; the app is stapled,
    # so it opens offline.
    rm -rf "$OUT/notarise" "$OUT/notarise.zip"; mkdir -p "$OUT/notarise"
    cp "$OUT/stage/wisp" "$OUT/stage/wisp-tui" "$OUT/notarise/"
    ditto "$OUT/stage/Wisp Notifier.app" "$OUT/notarise/Wisp Notifier.app"
    ditto "$OUT/Wisp.app" "$OUT/notarise/Wisp.app"
    ditto -c -k --keepParent "$OUT/notarise" "$OUT/notarise.zip"
    notarise "$OUT/notarise.zip"
    [ "$DRY_RUN" = "--dry-run" ] || xcrun stapler staple -q "$OUT/Wisp.app"
    # Then the disk image holding the stapled app, signed, notarised, and stapled in its turn (ADR 0072).
    echo "==> DMG"
    WISP_SIGN_IDENTITY="$SIGN_IDENTITY" scripts/wisp-dmg "$OUT/Wisp.app" "$OUT/$DMG" "$VERSION" >/dev/null
    notarise "$OUT/$DMG"
    if [ "$DRY_RUN" != "--dry-run" ]; then
        xcrun stapler staple -q "$OUT/$DMG"
        spctl -a -t open --context context:primary-signature "$OUT/$DMG" \
            || { echo "Gatekeeper does not accept $DMG after notarisation" >&2; exit 1; }
    fi
fi

echo "==> package"
{
    printf '%s\n\n' "$NOTES"
    if [ -n "$SIGN_IDENTITY" ]; then
        printf 'Install or upgrade with Homebrew: `brew install pidster/tap/wisp`, or download `%s` and drag Wisp.app to Applications. Everything is signed with a Developer ID and notarised by Apple, so the tarball runs when downloaded directly too.\n' "$DMG"
    else
        printf 'Install or upgrade with Homebrew: `brew install pidster/tap/wisp`. Downloading the tarball directly leaves it quarantined; use Homebrew.\n'
    fi
} > "$OUT/notes.md"
(cd "$OUT/stage" && tar -czf "../$TARBALL" wisp wisp-tui mlx.metallib "Wisp Notifier.app" LICENSE)
(cd "$OUT" && shasum -a 256 "$TARBALL" > "$TARBALL.sha256")
# The assets the GitHub release carries: the tarball, and for a signed release the DMG, each with its checksum.
ASSETS="$OUT/$TARBALL $OUT/$TARBALL.sha256"
if [ -n "$SIGN_IDENTITY" ]; then
    (cd "$OUT" && shasum -a 256 "$DMG" > "$DMG.sha256")
    ASSETS="$ASSETS $OUT/$DMG $OUT/$DMG.sha256"
    ls -la "$OUT/$DMG"
fi
SHA="$(cut -d' ' -f1 "$OUT/$TARBALL.sha256")"
ls -la "$OUT/$TARBALL"; echo "sha256 $SHA"

# The formula is written before anything is published, so a publish that fails part way has it to finish with.
# No `version` line: Homebrew scans the version from the URL's releases/download/vX.Y.Z/, and `brew audit` calls a
# `version` equal to the scanned one redundant (resource_auditor.rb, audit_version).
FORMULA="$OUT/wisp.rb"
cat > "$FORMULA" <<RUBY
class Wisp < Formula
  desc "On-device, tool-using AI microharness for macOS"
  homepage "https://github.com/pidster/wisp"
  url "https://github.com/pidster/wisp/releases/download/$TAG/$TARBALL"
  sha256 "$SHA"
  license "MIT"

  depends_on arch: :arm64
  depends_on macos: :golden_gate

  def install
    # MLX finds mlx.metallib beside the binary's real path (dladdr resolves Homebrew's links), so both
    # live in libexec and bin links to the binary (ADR 0047).
    # Wisp Notifier.app beside wisp, where wisp looks for it (ADR 0070); not in /Applications, and not a cask.
    libexec.install "wisp", "mlx.metallib", "Wisp Notifier.app"
    bin.install_symlink libexec/"wisp"
    bin.install "wisp-tui"
    # Where the parts are, relative to libexec/wisp, for wisp and its doctor's package finding (ADR 0072).
    (libexec/"wisp-layout.json").write <<~JSON
      {"frontEnd": "../bin/wisp-tui", "notifier": "Wisp Notifier.app", "metalLibrary": "mlx.metallib"}
    JSON
    # The completion scripts are embedded in the binary; this runs 'wisp completions bash|zsh|fish' into
    # bash_completion, zsh_completion, and fish_completion.
    generate_completions_from_executable(bin/"wisp", "completions")
  end

  test do
    assert_equal "$VERSION", shell_output("#{bin}/wisp --version").strip
    assert_equal "$VERSION", shell_output("#{bin}/wisp-tui --version").strip
    assert_path_exists libexec/"mlx.metallib"
    assert_path_exists libexec/"wisp-layout.json"
    assert_predicate libexec/"Wisp Notifier.app/Contents/MacOS/WispNotifier", :executable?
    assert_path_exists zsh_completion/"_wisp"
    assert_path_exists bash_completion/"wisp"
    assert_path_exists fish_completion/"wisp.fish"
    assert_match "#compdef wisp", shell_output("#{bin}/wisp completions zsh")
  end
end
RUBY
echo "formula written to $FORMULA"
TAP_DIR="$OUT/tap"
TAP_PUBLISH="rm -rf '$TAP_DIR' && gh repo clone $TAP_REPO '$TAP_DIR' && mkdir -p '$TAP_DIR/Formula' && cp '$FORMULA' '$TAP_DIR/Formula/wisp.rb' && cd '$TAP_DIR' && git add Formula/wisp.rb && git commit -m 'wisp $VERSION' && git push"

echo "==> publish"
unchanged
# The publish step under way. A release that fails once it has tagged cannot simply be rerun (preflight refuses an
# existing tag), so a failure from here on prints, exactly, the steps still to do, to run by hand; the artifacts and
# the formula stay in $OUT until the next release run.
STEP=""
recovery() {
    status=$?
    [ "$status" -ne 0 ] && [ -n "$STEP" ] && [ "$DRY_RUN" != "--dry-run" ] || return 0
    {
        echo "==> the release stopped at '$STEP' (exit $status). Nothing is undone; to finish it, run in $ROOT:"
        case "$STEP" in
            tag) echo "    git tag -l $TAG | grep -q . || git tag -a $TAG -m 'wisp $VERSION'" ;;
        esac
        case "$STEP" in
            tag | push) echo "    git push origin $TAG" ;;
        esac
        case "$STEP" in
            tag | push | release)
                echo "    if gh release view $TAG >/dev/null 2>&1; then gh release upload $TAG $ASSETS --clobber;"
                echo "    else gh release create $TAG $ASSETS --title 'wisp $VERSION' --notes-file '$OUT/notes.md'; fi"
                ;;
        esac
        echo "    sh -c \"$TAP_PUBLISH\""
        case "$STEP" in
            tag | push) echo "  or, to abandon it while nothing is pushed: git tag -d $TAG, fix, and rerun scripts/release $VERSION" ;;
        esac
    } >&2
}
trap recovery EXIT
STEP=tag
remote git tag -a "$TAG" -m "wisp $VERSION"
STEP=push
remote git push origin "$TAG"
STEP=release
# shellcheck disable=SC2086 # $ASSETS is split into paths on purpose; none has a space (they are under $OUT)
remote gh release create "$TAG" $ASSETS --title "wisp $VERSION" --notes-file "$OUT/notes.md"

echo "==> tap formula"
STEP=tap
remote sh -c "$TAP_PUBLISH"
STEP=""

echo "==> done"
echo "verify: brew update && brew install pidster/tap/wisp && wisp doctor (its signature line names the signer)"

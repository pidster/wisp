#!/bin/sh
# Cut a release: preflight, build, package, tag, GitHub release, Homebrew tap formula.
# Usage: scripts/release X.Y.Z [--dry-run] [--skip-eval]
# See docs/release.md. Remote steps (tag push, release, tap push) are printed, not run, with --dry-run.
# --skip-eval leaves out the model eval, for a release whose eval already passed on the same code (a dry
# run just before, with only docs changed since); say so in the release notes or the commit that follows.
set -eu

VERSION="${1:-}"
[ -n "$VERSION" ] || { echo "usage: scripts/release X.Y.Z [--dry-run] [--skip-eval]" >&2; exit 64; }
# Exactly three dot-separated numbers: 1.2 or 1.2.3.4 would tag a version Homebrew and WispVersion disagree on.
printf '%s\n' "$VERSION" | grep -Eqx '(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)' \
    || { echo "version must be X.Y.Z (three numbers, no leading zeros), not '$VERSION'" >&2; exit 64; }
shift
DRY_RUN=""
SKIP_EVAL=""
for flag in "$@"; do
    case "$flag" in
        --dry-run) DRY_RUN="--dry-run" ;;
        --skip-eval) SKIP_EVAL=1 ;;
        *) echo "unknown flag $flag" >&2; exit 64 ;;
    esac
done

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
TAG="v$VERSION"
TARBALL="wisp-$VERSION-arm64.tar.gz"
TAP_REPO="pidster/homebrew-tap"
OUT="$ROOT/harness/.build/release-artifacts"

remote() {
    if [ "$DRY_RUN" = "--dry-run" ]; then
        echo "[dry-run] $*"
    else
        "$@"
    fi
}

echo "==> preflight"
missing=""
for page in docs/*.md docs/decisions/*.md docs/proposals/*.md docs/tools/*.md; do
    case "$page" in docs/README.md|docs/tools/README.md) continue ;; esac
    name="${page#docs/}"
    index=docs/README.md
    case "$page" in docs/tools/*) index=docs/tools/README.md; name="${page#docs/tools/}" ;; esac
    grep -q "($name)" "$index" || missing="$missing $page"
done
[ -z "$missing" ] || { echo "not in the docs index:$missing (see docs/release.md, step 0)" >&2; exit 1; }
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || { echo "not on main" >&2; exit 1; }
[ -z "$(git status --porcelain)" ] || { echo "working tree not clean" >&2; exit 1; }
START="$(git rev-parse HEAD)"
# The binary is built from the working tree, so the tree and HEAD must stay as preflight found them
# until the release is published: 0.13.0 shipped an edit made while its evals ran.
unchanged() {
    [ "$(git rev-parse HEAD)" = "$START" ] || { echo "HEAD moved during the release ($START to $(git rev-parse HEAD)); rerun" >&2; exit 1; }
    [ -z "$(git status --porcelain)" ] || { echo "the working tree changed during the release; the build would not match $TAG:" >&2; git status --short >&2; exit 1; }
}
grep -q "^version = \"$VERSION\"" tools/wisp-tui/Cargo.toml || { echo "tools/wisp-tui/Cargo.toml version is not $VERSION" >&2; exit 1; }
command -v cargo >/dev/null || { echo "cargo is needed to build wisp-tui" >&2; exit 1; }
xcrun -f metal >/dev/null 2>&1 || { echo "the Metal toolchain is needed to build MLX: xcodebuild -downloadComponent MetalToolchain" >&2; exit 1; }
CURRENT="$(sed -n 's/.*public static let current = "\([^"]*\)".*/\1/p' harness/Sources/WispCore/Audit/AuditEvent.swift)"
[ "$CURRENT" = "$VERSION" ] || { echo "WispVersion.current is $CURRENT, not $VERSION; bump it first" >&2; exit 1; }
SHIPPED="$(sed -n 's/^ *"version" : "\([^"]*\)",*$/\1/p' harness/Sources/WispCore/Resources/risk-default.json | head -1)"
[ "$SHIPPED" = "$VERSION-default" ] || { echo "the shipped classifier is $SHIPPED, not $VERSION-default; run scripts/check classifier-default after the bump" >&2; exit 1; }
if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then echo "tag $TAG exists" >&2; exit 1; fi
gh auth status >/dev/null 2>&1 || { echo "gh is not authenticated" >&2; exit 1; }
# The remote, read only, before the slow steps: the tag must not exist on origin (a local check misses one pushed
# from another clone), and origin/main must be HEAD, so the tag names a commit that is pushed and nothing on origin is
# left out. A dry run, often made before pushing, reports these and goes on.
remote_problem() {
    if [ "$DRY_RUN" = "--dry-run" ]; then
        echo "[dry-run] would stop here: $*" >&2
    else
        echo "$*" >&2
        exit 1
    fi
}
if remote_tag="$(git ls-remote --tags origin "refs/tags/$TAG")"; then
    [ -z "$remote_tag" ] || remote_problem "tag $TAG exists on origin"
else
    remote_problem "could not ask origin for its tags (git ls-remote failed)"
fi
if remote_main="$(git ls-remote origin refs/heads/main | cut -f1)" && [ -n "$remote_main" ]; then
    if [ "$remote_main" != "$START" ]; then
        if git merge-base --is-ancestor "$remote_main" "$START" 2>/dev/null; then
            remote_problem "main is not pushed: origin/main is $remote_main, HEAD is $START; push it first"
        else
            remote_problem "main is behind or has diverged from origin/main ($remote_main); pull, check, and rerun"
        fi
    fi
else
    remote_problem "could not read origin's main (git ls-remote failed)"
fi
NOTES="$(awk -v v="$VERSION" '
    $0 == "## " v { on = 1; next }
    /^## / { on = 0 }
    on { print }
' CHANGELOG.md | sed -e '/./,$!d')"
[ -n "$NOTES" ] || { echo "CHANGELOG.md has no section '## $VERSION'; write the release notes first" >&2; exit 1; }
scripts/check all
# The code only the MLX trait compiles, with its tests, warnings as errors: the release build below is the first
# build of it otherwise, and a failure there comes after the eval's hour.
scripts/check mlx-build
scripts/check coverage-gate
if [ -n "$SKIP_EVAL" ]; then
    echo "==> eval skipped (--skip-eval): it must have passed on this code already" >&2
else
    scripts/check eval
fi
if [ -n "$(git status --porcelain harness/Sources/WispCore/Resources/measurements.json)" ]; then
    echo "the eval changed harness/Sources/WispCore/Resources/measurements.json; commit it (the binary must carry the numbers that are committed) and rerun" >&2
    exit 1
fi

echo "==> build"
unchanged
# With MLX (ADR 0047): MLX loads its Metal library at run time, first as mlx.metallib beside the binary.
# WISP_RELEASE=1 makes --version print the bare version (the build plugin reads it).
(cd harness && WISP_RELEASE=1 swift build -c release --traits MLX)
(cd tools && WISP_RELEASE=1 cargo build --release -q -p wisp-tui)
BIN_DIR="$(cd harness && WISP_RELEASE=1 swift build -c release --traits MLX --show-bin-path)"
BIN="$BIN_DIR/wisp"
TUI="tools/target/release/wisp-tui"
METALLIB=""
for candidate in "$BIN_DIR/mlx-swift_Cmlx.bundle/Contents/Resources/default.metallib" \
    "$BIN_DIR/mlx-swift_Cmlx.bundle/default.metallib"; do
    if [ -f "$candidate" ]; then METALLIB="$candidate"; break; fi
done
[ -n "$METALLIB" ] || { echo "no default.metallib in $BIN_DIR/mlx-swift_Cmlx.bundle; was MLX built?" >&2; exit 1; }
rm -rf "$OUT"; mkdir -p "$OUT/stage"
cp "$BIN" "$OUT/stage/wisp"
cp "$TUI" "$OUT/stage/wisp-tui"
cp "$METALLIB" "$OUT/stage/mlx.metallib"
strip "$OUT/stage/wisp" "$OUT/stage/wisp-tui"
cp LICENSE "$OUT/stage/LICENSE"
[ "$("$OUT/stage/wisp" --version)" = "$VERSION" ] || { echo "built binary reports $("$OUT/stage/wisp" --version)" >&2; exit 1; }
[ "$("$OUT/stage/wisp-tui" --version)" = "$VERSION" ] || { echo "wisp-tui reports $("$OUT/stage/wisp-tui" --version); set version in tools/wisp-tui/Cargo.toml" >&2; exit 1; }
"$OUT/stage/wisp" doctor
# The staged binary, away from the build's bundle, must find the staged library.
STAGE_REAL="$(cd "$OUT/stage" && pwd -P)"
"$OUT/stage/wisp" doctor | grep -qxF "ok   MLX: Metal library $STAGE_REAL/mlx.metallib loads" \
    || { echo "the staged wisp does not load the staged mlx.metallib (wisp doctor's MLX finding)" >&2; exit 1; }
# The formula installs the completions from 'wisp completions <shell>'; the staged binary must print the committed ones.
for entry in zsh:_wisp bash:wisp.bash fish:wisp.fish; do
    "$OUT/stage/wisp" completions "${entry%%:*}" | cmp -s - "harness/Sources/WispCore/Resources/completions/${entry#*:}" \
        || { echo "the staged wisp's ${entry%%:*} completions differ from the committed ${entry#*:}" >&2; exit 1; }
done

echo "==> package"
{
    printf '%s\n\n' "$NOTES"
    printf 'Install or upgrade with Homebrew: `brew install pidster/tap/wisp`. Downloading the tarball directly leaves it quarantined; use Homebrew.\n'
} > "$OUT/notes.md"
(cd "$OUT/stage" && tar -czf "../$TARBALL" wisp wisp-tui mlx.metallib LICENSE)
(cd "$OUT" && shasum -a 256 "$TARBALL" > "$TARBALL.sha256")
SHA="$(cut -d' ' -f1 "$OUT/$TARBALL.sha256")"
ls -la "$OUT/$TARBALL"; echo "sha256 $SHA"

# The formula is written before anything is published, so a publish that fails part way has it to finish with.
# No `version` line: Homebrew scans the version from the URL's releases/download/vX.Y.Z/, and `brew audit` calls a
# `version` equal to the scanned one redundant (resource_auditor.rb, audit_version).
FORMULA="$OUT/wisp.rb"
cat > "$FORMULA" <<RUBY
class Wisp < Formula
  desc "On-device, tool-using AI microharness for macOS"
  homepage "https://github.com/pidster/wisp"
  url "https://github.com/pidster/wisp/releases/download/$TAG/$TARBALL"
  sha256 "$SHA"
  license "MIT"

  depends_on arch: :arm64
  depends_on macos: :golden_gate

  def install
    # MLX finds mlx.metallib beside the binary's real path (dladdr resolves Homebrew's links), so both
    # live in libexec and bin links to the binary (ADR 0047).
    libexec.install "wisp", "mlx.metallib"
    bin.install_symlink libexec/"wisp"
    bin.install "wisp-tui"
    # The completion scripts are embedded in the binary; this runs 'wisp completions bash|zsh|fish' into
    # bash_completion, zsh_completion, and fish_completion.
    generate_completions_from_executable(bin/"wisp", "completions")
  end

  test do
    assert_equal "$VERSION", shell_output("#{bin}/wisp --version").strip
    assert_equal "$VERSION", shell_output("#{bin}/wisp-tui --version").strip
    assert_path_exists libexec/"mlx.metallib"
    assert_path_exists zsh_completion/"_wisp"
    assert_path_exists bash_completion/"wisp"
    assert_path_exists fish_completion/"wisp.fish"
    assert_match "#compdef wisp", shell_output("#{bin}/wisp completions zsh")
  end
end
RUBY
echo "formula written to $FORMULA"
TAP_DIR="$OUT/tap"
TAP_PUBLISH="rm -rf '$TAP_DIR' && gh repo clone $TAP_REPO '$TAP_DIR' && mkdir -p '$TAP_DIR/Formula' && cp '$FORMULA' '$TAP_DIR/Formula/wisp.rb' && cd '$TAP_DIR' && git add Formula/wisp.rb && git commit -m 'wisp $VERSION' && git push"

echo "==> publish"
unchanged
# The publish step under way. A release that fails once it has tagged cannot simply be rerun (preflight refuses an
# existing tag), so a failure from here on prints, exactly, the steps still to do, to run by hand; the artifacts and
# the formula stay in $OUT until the next release run.
STEP=""
recovery() {
    status=$?
    [ "$status" -ne 0 ] && [ -n "$STEP" ] && [ "$DRY_RUN" != "--dry-run" ] || return 0
    {
        echo "==> the release stopped at '$STEP' (exit $status). Nothing is undone; to finish it, run in $ROOT:"
        case "$STEP" in
            tag) echo "    git tag -l $TAG | grep -q . || git tag -a $TAG -m 'wisp $VERSION'" ;;
        esac
        case "$STEP" in
            tag | push) echo "    git push origin $TAG" ;;
        esac
        case "$STEP" in
            tag | push | release)
                echo "    if gh release view $TAG >/dev/null 2>&1; then gh release upload $TAG '$OUT/$TARBALL' '$OUT/$TARBALL.sha256' --clobber;"
                echo "    else gh release create $TAG '$OUT/$TARBALL' '$OUT/$TARBALL.sha256' --title 'wisp $VERSION' --notes-file '$OUT/notes.md'; fi"
                ;;
        esac
        echo "    sh -c \"$TAP_PUBLISH\""
        case "$STEP" in
            tag | push) echo "  or, to abandon it while nothing is pushed: git tag -d $TAG, fix, and rerun scripts/release $VERSION" ;;
        esac
    } >&2
}
trap recovery EXIT
STEP=tag
remote git tag -a "$TAG" -m "wisp $VERSION"
STEP=push
remote git push origin "$TAG"
STEP=release
remote gh release create "$TAG" "$OUT/$TARBALL" "$OUT/$TARBALL.sha256" --title "wisp $VERSION" \
    --notes-file "$OUT/notes.md"

echo "==> tap formula"
STEP=tap
remote sh -c "$TAP_PUBLISH"
STEP=""

echo "==> done"
echo "verify: brew update && brew install pidster/tap/wisp && wisp doctor"

#!/bin/sh
# Single entry point for every quality check. Used by .githooks/pre-commit,
# .github/workflows/ci.yml, and humans. See docs/engineering.md.
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
SWIFT_PATHS="Sources Tests Plugins Package.swift Evals/Tests Evals/Package.swift"

# Rust checks run only once the workspace has at least one crate.
have_crates() {
    ls tools/*/Cargo.toml >/dev/null 2>&1
}

# True when this shell already runs inside a Seatbelt sandbox (for example when wisp runs the gate
# through its own run_command). SwiftPM then needs --disable-sandbox, and nested sandbox tests are moot.
nested_sandbox() {
    ! sandbox-exec -p '(version 1) (allow default) (deny file-write* (subpath "/nonexistent/wisp-nesting-probe"))' \
        /usr/bin/true 2>/dev/null
}
if nested_sandbox; then SWIFT_SANDBOX="--disable-sandbox"; else SWIFT_SANDBOX=""; fi

lint() {
    echo "==> lint (swift)"
    (cd harness && swift format lint --recursive --strict $SWIFT_PATHS)
    if have_crates; then
        echo "==> lint (rust)"
        (cd tools && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings)
    fi
}

build() {
    echo "==> build (swift, warnings are errors)"
    (cd harness && swift build $SWIFT_SANDBOX -Xswiftc -warnings-as-errors)
    if have_crates; then
        echo "==> build (rust, warnings are errors)"
        (cd tools && RUSTFLAGS="-D warnings" cargo build --workspace)
    fi
}

test_() {
    echo "==> test (swift)"
    (cd harness && swift test $SWIFT_SANDBOX)
    if nested_sandbox; then
        echo "==> test (swift, runner suites inside an outer sandbox): already nested, skipped"
    else
        echo "==> test (swift, runner suites inside an outer sandbox)"
        log="$(mktemp)"
        if (cd harness && sandbox-exec -p '(version 1) (allow default)' swift test --disable-sandbox --filter 'CommandRunner|NestedSandbox' >"$log" 2>&1); then
            grep -E 'Test run with' "$log" | tail -1
        else
            grep -E 'Test run with|✘|error' "$log" | tail -8
            rm -f "$log"
            echo "nested-sandbox test step failed" >&2
            exit 1
        fi
        rm -f "$log"
    fi
    if have_crates; then
        echo "==> test (rust)"
        (cd tools && cargo test --workspace)
    fi
}

coverage_report() {
    (
        cd harness
        swift test $SWIFT_SANDBOX --enable-code-coverage >/dev/null 2>&1 || swift test $SWIFT_SANDBOX --enable-code-coverage
        profile="$(dirname "$(swift test --show-codecov-path)")/default.profdata"
        set -- .build/out/Products/Debug/*.xctest/Contents/MacOS/*
        first="$1"; shift
        objects=""
        for bin in "$@"; do objects="$objects -object $bin"; done
        # shellcheck disable=SC2086
        xcrun llvm-cov report "$first" $objects -instr-profile "$profile" \
            -ignore-filename-regex='(\.build|Tests|checkouts)/' -show-region-summary=false
    )
}

coverage() {
    echo "==> coverage (swift)"
    coverage_report
}

# The total line coverage as a number, such as 92.64.
coverage_total() {
    coverage_report | awk '/^TOTAL/ { sub("%", "", $7); print $7 }'
}

BASELINE_FILE="harness/coverage-baseline"

# Refuses when total line coverage is below the recorded baseline; run before every release.
# Timing-dependent branches (sandbox nesting, timeouts) move the figure by a few hundredths between
# runs, so a tenth of a point either way counts as unchanged.
COVERAGE_TOLERANCE=0.1

coverage_gate() {
    echo "==> coverage gate"
    total="$(coverage_total)"
    baseline="$(cat "$BASELINE_FILE" 2>/dev/null || echo 0)"
    echo "line coverage $total% (baseline $baseline%, tolerance $COVERAGE_TOLERANCE)"
    if awk -v t="$total" -v b="$baseline" -v e="$COVERAGE_TOLERANCE" 'BEGIN { exit !(t + 0 < b - e) }'; then
        echo "coverage fell below the baseline; add tests or, with a reason in the commit, lower $BASELINE_FILE" >&2
        exit 1
    fi
    if awk -v t="$total" -v b="$baseline" -v e="$COVERAGE_TOLERANCE" 'BEGIN { exit !(t + 0 > b + e) }'; then
        echo "coverage rose; record it with 'scripts/check coverage-baseline' and commit before releasing" >&2
        exit 1
    fi
}

# Writes the current total line coverage as the baseline the gate compares against.
coverage_baseline() {
    total="$(coverage_total)"
    echo "$total" > "$BASELINE_FILE"
    echo "baseline set to $total% in $BASELINE_FILE"
}

# eval: run the model evaluations (the package in harness/Evals, which the gate never builds) and assert
# their floors. `eval record` also writes each task's
# measurement into the embedded measurements.json, to commit; a plain eval (what a release runs)
# leaves the file alone, since the sets are small and a rerun re-rolls the numbers. `eval compare` runs the
# suites that decide delegation on each model WISP_EVAL_MODELS names, one model at a time (docs/measurements.md).
# Every run ends with a summary table, model by suite, saved with the run's whole output under
# harness/Evals/.build/evals.
EVAL_LINES='model classifier|measured:|eval:|^  [a-z]+ -> |^[a-z-]+	|✔|✘|Test run'
# The suites that decide delegation: tool calls and schema replies, system_info's topics, triage, summarise_diff,
# draft_change, the classifier's model fallback alone and beside the rules, and one context scenario.
EVAL_COMPARE_SUITES='ToolEvalTests|SystemInfoEvalTests|TriageEvalTests|DiffSummaryEvalTests|DraftEvalTests|ClassifierEvalTests/(measuresTheModelAlone|theDefaultAsTheGateRunsIt)|ContextEvalTests/comparisonOnEachModel'
eval_() {
    # The context suite is a measurement for design decisions (ADR 0045), run on purpose with
    # `eval context`; the plain eval, which a release runs, covers every other suite and its floors.
    record=""
    compare=""
    scope="--skip ContextEvalTests"
    label="every suite but the context eval"
    for arg in "$@"; do
        case "$arg" in
            record) record="$ROOT/harness/Sources/WispCore/Resources/measurements.json" ;;
            context) scope="--filter ContextEvalTests"; label="the context eval only" ;;
            compare) compare=1 ;;
            *) echo "usage: scripts/check eval [context|compare] [record]" >&2; exit 64 ;;
        esac
    done
    out="$ROOT/harness/Evals/.build/evals"
    mkdir -p "$out"
    log="$out/eval-$(date +%Y%m%d-%H%M%S).log"
    if [ -n "$compare" ]; then
        if [ -z "${WISP_EVAL_MODELS:-}" ]; then
            echo "eval compare needs WISP_EVAL_MODELS, comma-separated, such as ollama:granite4.1:8b,ollama:llama3.2:3b" >&2
            exit 64
        fi
        # One `swift test` per model, its suites one after another, so a local runtime holds one model at a
        # time and each case's time is that model's alone. A model that fails or is missing fails its cells only.
        models="$(echo "$WISP_EVAL_MODELS" | tr ',' ' ')"
        for model in $models; do
            echo "==> eval compare on $model: tool calls, schema replies, system_info, triage, summarise_diff, draft_change, the model classifier, one context scenario"
            # shellcheck disable=SC2086 # $SWIFT_SANDBOX is empty or one word on purpose
            (cd harness/Evals && WISP_MODEL_TESTS=1 WISP_EVAL_MODELS="$model" WISP_EVAL_RECORD="$record" \
                swift test $SWIFT_SANDBOX --no-parallel --filter "$EVAL_COMPARE_SUITES" 2>&1) \
                | tee -a "$log" | grep -E "$EVAL_LINES" || true
        done
    else
        echo "==> eval (on-device model; not part of the gate): $label"
        # shellcheck disable=SC2086 # $scope is two words on purpose
        (cd harness/Evals && WISP_MODEL_TESTS=1 WISP_EVAL_RECORD="$record" swift test $SWIFT_SANDBOX $scope 2>&1) \
            | tee -a "$log" | grep -E "$EVAL_LINES"
    fi
    eval_summary "$log" | tee "${log%.log}.summary.txt"
    echo "==> output in $log, summary in ${log%.log}.summary.txt"
    if [ -n "$record" ]; then
        echo "==> measurements recorded in harness/Sources/WispCore/Resources/measurements.json; commit them"
    fi
}

# The summary of an eval's output: each suite's `eval result` line (EvalModels.result) as a table, a row per model
# and a column per suite, each cell passed/total and the median time per case; a cell's note below the table.
eval_summary() {
    awk -F '\t' '
        $1 == "eval result" {
            model = $2; suite = $3
            if (!(model in seenModel)) { seenModel[model] = 1; models[++modelCount] = model }
            if (!(suite in seenSuite)) { seenSuite[suite] = 1; suites[++suiteCount] = suite }
            if ($5 + 0 == 0) {
                cell = "n/a"
            } else {
                cell = $4 "/" $5
                if ($6 != "") cell = cell " " ($6 + 0 < 1000 ? sprintf("%dms", $6) : sprintf("%.1fs", $6 / 1000))
            }
            if ($7 != "") { cell = cell "*"; notes[model, suite] = $7 }
            cells[model, suite] = cell
        }
        END {
            if (modelCount == 0) exit
            print "==> summary: passed/total and median time per case, a row per model"
            width = length("model")
            for (m = 1; m <= modelCount; m++) if (length(models[m]) > width) width = length(models[m])
            line = sprintf("%-" width "s", "model")
            for (s = 1; s <= suiteCount; s++) {
                w[s] = length(suites[s])
                for (m = 1; m <= modelCount; m++) {
                    c = ((models[m], suites[s]) in cells) ? cells[models[m], suites[s]] : "-"
                    if (length(c) > w[s]) w[s] = length(c)
                }
                line = line "  " sprintf("%-" w[s] "s", suites[s])
            }
            sub(/ +$/, "", line)
            print line
            for (m = 1; m <= modelCount; m++) {
                line = sprintf("%-" width "s", models[m])
                for (s = 1; s <= suiteCount; s++) {
                    c = ((models[m], suites[s]) in cells) ? cells[models[m], suites[s]] : "-"
                    line = line "  " sprintf("%-" w[s] "s", c)
                }
                sub(/ +$/, "", line)
                print line
            }
            for (m = 1; m <= modelCount; m++)
                for (s = 1; s <= suiteCount; s++)
                    if ((models[m], suites[s]) in notes) print "* " models[m] " " suites[s] ": " notes[models[m], suites[s]]
            print "- : no result (the suite did not finish, or was not run)"
        }
    ' "$1"
}

# mlx-live <model directory>: the MLX live test, which runs real weights (not part of the gate). Built with
# the MLX trait in a scratch path of its own, so the gate's build is not rebuilt; MLX loads its Metal library
# from beside the binary holding its code, which under `swift test` is the test bundle's (ADR 0047), so the
# build's default.metallib is copied there as mlx.metallib first.
mlx_live() {
    [ $# -eq 1 ] || { echo "usage: scripts/check mlx-live <model directory>" >&2; exit 64; }
    scratch="$ROOT/harness/.build/mlx"
    echo "==> MLX live test (needs the Metal toolchain and a model; not part of the gate)"
    bin="$(swift build --package-path harness --build-tests --traits MLX --scratch-path "$scratch" --show-bin-path)"
    # The library copied into each test bundle below is unsigned, so a build that relinks a bundle fails to sign
    # it: the copies are removed before building (an earlier run may have been killed) and when the run ends.
    rm -f "$bin"/*.xctest/Contents/MacOS/mlx.metallib
    trap 'rm -f "$bin"/*.xctest/Contents/MacOS/mlx.metallib' EXIT
    swift build --package-path harness $SWIFT_SANDBOX --build-tests --traits MLX --scratch-path "$scratch"
    metallib=""
    for candidate in "$bin/mlx-swift_Cmlx.bundle/Contents/Resources/default.metallib" \
        "$bin/mlx-swift_Cmlx.bundle/default.metallib"; do
        if [ -f "$candidate" ]; then metallib="$candidate"; break; fi
    done
    [ -n "$metallib" ] || { echo "no default.metallib in $bin/mlx-swift_Cmlx.bundle" >&2; exit 1; }
    for dir in "$bin"/*.xctest/Contents/MacOS; do cp "$metallib" "$dir/mlx.metallib"; done
    WISP_MLX_TESTS=1 WISP_MLX_MODEL="$1" swift test --package-path harness $SWIFT_SANDBOX --traits MLX \
        --scratch-path "$scratch" --skip-build --filter 'MLXLiveTests|MetalLibraryTests'
}

# classifier-default: copy the risk train set into the bundled examples, then train the risk classifier
# this version ships from them into the embedded resource; run after WispVersion.current is bumped, and
# commit both resources with the bump. The shipped file is what the release carries, measured by the eval.
classifier_default() {
    echo "==> shipped classifier"
    bundle_risk_examples
    (cd harness && swift build $SWIFT_SANDBOX -q && .build/debug/wisp classifier ship \
        --resource Sources/WispCore/Resources/risk-default.json)
}

# The bundled risk examples are a copy of training/risk/train.tsv under a header; TrainingSetsTests fails
# if they differ, so the train set is the one place to edit.
bundle_risk_examples() {
    {
        echo "# The risk classifier's bundled training examples: a copy of training/risk/train.tsv, written by"
        echo "# scripts/check classifier-default. Edit training/risk/train.tsv, never this file; TrainingSetsTests"
        echo "# fails if the two differ. Labels and rules: training/risk/labels.md."
        grep -v '^#' training/risk/train.tsv
    } > harness/Sources/WispCore/Resources/risk-examples.tsv
}

format() {
    (cd harness && swift format --in-place --recursive $SWIFT_PATHS)
    if have_crates; then (cd tools && cargo fmt --all); fi
}

hygiene() {
    echo "==> hygiene"
    status=0
    staged=$(git diff --cached --name-only --diff-filter=ACMR)

    for f in $staged; do
        case "$f" in *.swift|*.rs|*.toml|*.md|*.yml|*.yaml|*.json|*.sh|scripts/*)
            if grep -nE '^(<<<<<<<|=======|>>>>>>>)( |$)' "$f" >/dev/null 2>&1; then
                echo "conflict marker: $f"; status=1
            fi
            if grep -nE '[[:blank:]]+$' "$f" >/dev/null 2>&1; then
                echo "trailing whitespace: $f"; status=1
            fi
        esac
        # Files may not exceed 1 MiB, so nothing large is committed by accident. The one exception is the
        # personal-data classifier (ADR 0042): its weights do not compress, and it is retrained only when
        # training/secrets changes. Add to this list only with an ADR that says why.
        case "$f" in
            harness/Sources/WispCore/Resources/personal-default.json) ;;
            *)
                if [ -f "$f" ] && [ "$(wc -c <"$f")" -gt 1048576 ]; then
                    echo "file over 1 MiB: $f"; status=1
                fi
                ;;
        esac
    done

    if printf '%s\n' "$staged" | grep -qE '^(harness/Sources|tools/)' \
        && ! printf '%s\n' "$staged" | grep -qE '^(docs/|CLAUDE\.md|README\.md)'; then
        echo "reminder: code changed but nothing under docs/ did; see the definition of done in docs/engineering.md"
    fi

    email=$(git config user.email || true)
    case "$email" in
        *@users.noreply.github.com) ;;
        *) echo "git user.email '$email' is not a GitHub noreply address; GitHub will reject the push"; status=1 ;;
    esac

    return $status
}

# palette: Style.Palette (Swift) and palette.rs (wisp-tui) define the same colours twice; fail when they
# disagree. A Swift name maps to Rust's by upper-casing at each word break (tokensIn -> TOKENS_IN). Every
# Swift colour must exist in Rust with the same value; Rust may have extras (DEEP, SENT, WHITE are
# TUI-only). An alias on either side (`tokensOut = glow`, `TOKENS_OUT: Color = GLOW`) is resolved first.
palette() {
    echo "==> palette (Swift and Rust agree)"
    awk '
        function num(h,   i, n) {
            h = toupper(h); sub(/^0X/, "", h); n = 0
            for (i = 1; i <= length(h); i++) n = n * 16 + index("0123456789ABCDEF", substr(h, i, 1)) - 1
            return n
        }
        function hex(t,   c) { split(t, c, /, /); return sprintf("#%02X%02X%02X", num(c[1]), num(c[2]), num(c[3])) }
        function snake(name,   out, i, c) {
            out = ""
            for (i = 1; i <= length(name); i++) {
                c = substr(name, i, 1)
                out = out (c ~ /[A-Z]/ ? "_" c : toupper(c))
            }
            return out
        }
        function resolve(side, name,   guard) {
            while (!((side, name) in val) && ((side, name) in alias) && ++guard < 10) name = alias[side, name]
            return ((side, name) in val) ? val[side, name] : ""
        }
        FNR == 1 { side = (FILENAME ~ /\.swift$/) ? "swift" : "rust" }
        side == "swift" && /enum Palette/ { inside = 1 }
        side == "swift" && inside && /^    }/ { inside = 0 }
        side == "swift" && inside && /static let [a-zA-Z]+ = / {
            name = $0; sub(/.*static let /, "", name); sub(/ .*/, "", name)
            key = snake(name); order[++n] = key; swiftname[key] = name
            if (match($0, /\(0x[0-9A-Fa-f]+, 0x[0-9A-Fa-f]+, 0x[0-9A-Fa-f]+\)/)) {
                val["swift", key] = hex(substr($0, RSTART + 1, RLENGTH - 2))
            } else {
                a = $0; sub(/.*= /, "", a); alias["swift", key] = snake(a)
            }
        }
        side == "rust" && /^pub const [A-Z_]+: Color = / {
            name = $0; sub(/^pub const /, "", name); sub(/:.*/, "", name)
            if (match($0, /Rgb\(0x[0-9A-Fa-f]+, 0x[0-9A-Fa-f]+, 0x[0-9A-Fa-f]+\)/)) {
                val["rust", name] = hex(substr($0, RSTART + 4, RLENGTH - 5))
            } else {
                a = $0; sub(/.*= /, "", a); sub(/;.*/, "", a); alias["rust", name] = a
            }
        }
        END {
            if (n == 0) { print "palette: found no colours in Style.Palette" > "/dev/stderr"; exit 1 }
            for (i = 1; i <= n; i++) {
                k = order[i]; s = resolve("swift", k); r = resolve("rust", k)
                if (r == "") {
                    printf "palette mismatch: %s is %s in Swift, missing in Rust (%s)\n", swiftname[k], s, k > "/dev/stderr"
                    bad = 1
                } else if (s != r) {
                    printf "palette mismatch: %s is %s in Swift, %s in Rust\n", swiftname[k], s, r > "/dev/stderr"
                    bad = 1
                }
            }
            exit bad
        }
    ' harness/Sources/WispCore/CLI/Style.swift tools/wisp-tui/src/palette.rs
}

install_hooks() {
    git config core.hooksPath .githooks
    echo "core.hooksPath set to .githooks"
}

case "${1:-all}" in
    lint) lint ;;
    build) build ;;
    test) test_ ;;
    format) format ;;
    coverage) coverage ;;
    coverage-gate) coverage_gate ;;
    coverage-baseline) coverage_baseline ;;
    classifier-default) classifier_default ;;
    eval) shift; eval_ "$@" ;;
    mlx-live) shift; mlx_live "$@" ;;
    hygiene) hygiene ;;
    palette) palette ;;
    all) hygiene; palette; lint; build; test_ ;;
    install-hooks) install_hooks ;;
    *) echo "usage: scripts/check [lint|build|test|format|coverage|coverage-gate|coverage-baseline|classifier-default|eval [context|compare] [record]|mlx-live <model directory>|hygiene|palette|all|install-hooks]" >&2; exit 64 ;;
esac

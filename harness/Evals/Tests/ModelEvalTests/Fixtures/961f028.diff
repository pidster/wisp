@@ -209,6 +209,68 @@ hygiene() {
     return $status
 }
 
+# palette: Style.Palette (Swift) and palette.rs (wisp-tui) define the same colours twice; fail when they
+# disagree. A Swift name maps to Rust's by upper-casing at each word break (tokensIn -> TOKENS_IN). Every
+# Swift colour must exist in Rust with the same value; Rust may have extras (DEEP, SENT, WHITE are
+# TUI-only). An alias on either side (`tokensOut = glow`, `TOKENS_OUT: Color = GLOW`) is resolved first.
+palette() {
+    echo "==> palette (Swift and Rust agree)"
+    awk '
+        function num(h,   i, n) {
+            h = toupper(h); sub(/^0X/, "", h); n = 0
+            for (i = 1; i <= length(h); i++) n = n * 16 + index("0123456789ABCDEF", substr(h, i, 1)) - 1
+            return n
+        }
+        function hex(t,   c) { split(t, c, /, /); return sprintf("#%02X%02X%02X", num(c[1]), num(c[2]), num(c[3])) }
+        function snake(name,   out, i, c) {
+            out = ""
+            for (i = 1; i <= length(name); i++) {
+                c = substr(name, i, 1)
+                out = out (c ~ /[A-Z]/ ? "_" c : toupper(c))
+            }
+            return out
+        }
+        function resolve(side, name,   guard) {
+            while (!((side, name) in val) && ((side, name) in alias) && ++guard < 10) name = alias[side, name]
+            return ((side, name) in val) ? val[side, name] : ""
+        }
+        FNR == 1 { side = (FILENAME ~ /\.swift$/) ? "swift" : "rust" }
+        side == "swift" && /enum Palette/ { inside = 1 }
+        side == "swift" && inside && /^    }/ { inside = 0 }
+        side == "swift" && inside && /static let [a-zA-Z]+ = / {
+            name = $0; sub(/.*static let /, "", name); sub(/ .*/, "", name)
+            key = snake(name); order[++n] = key; swiftname[key] = name
+            if (match($0, /\(0x[0-9A-Fa-f]+, 0x[0-9A-Fa-f]+, 0x[0-9A-Fa-f]+\)/)) {
+                val["swift", key] = hex(substr($0, RSTART + 1, RLENGTH - 2))
+            } else {
+                a = $0; sub(/.*= /, "", a); alias["swift", key] = snake(a)
+            }
+        }
+        side == "rust" && /^pub const [A-Z_]+: Color = / {
+            name = $0; sub(/^pub const /, "", name); sub(/:.*/, "", name)
+            if (match($0, /Rgb\(0x[0-9A-Fa-f]+, 0x[0-9A-Fa-f]+, 0x[0-9A-Fa-f]+\)/)) {
+                val["rust", name] = hex(substr($0, RSTART + 4, RLENGTH - 5))
+            } else {
+                a = $0; sub(/.*= /, "", a); sub(/;.*/, "", a); alias["rust", name] = a
+            }
+        }
+        END {
+            if (n == 0) { print "palette: found no colours in Style.Palette" > "/dev/stderr"; exit 1 }
+            for (i = 1; i <= n; i++) {
+                k = order[i]; s = resolve("swift", k); r = resolve("rust", k)
+                if (r == "") {
+                    printf "palette mismatch: %s is %s in Swift, missing in Rust (%s)\n", swiftname[k], s, k > "/dev/stderr"
+                    bad = 1
+                } else if (s != r) {
+                    printf "palette mismatch: %s is %s in Swift, %s in Rust\n", swiftname[k], s, r > "/dev/stderr"
+                    bad = 1
+                }
+            }
+            exit bad
+        }
+    ' harness/Sources/WispCore/CLI/Style.swift tools/wisp-tui/src/palette.rs
+}

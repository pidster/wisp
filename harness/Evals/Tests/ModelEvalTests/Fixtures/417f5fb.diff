@@ -307,6 +307,12 @@ eval_() {
 # appending everything it prints to <log> and showing the lines EVAL_LINES selects as they come. Its exit status, and
 # EVAL_STATUS, are the command's own: in `cmd | tee | grep` the status is grep's, which matches `✘` and `Test run`
 # exactly when tests fail, so until 0.21.1 a failing eval, and the release's floors, passed.
+#
+# Every line reaches the log and the terminal as it is printed. The test process's `print` goes through C stdio, which
+# buffers a pipe in blocks, so a run's result lines once arrived only when it ended (six hours for granite4.2 on
+# 2026-10-09); NSUnbufferedIO=YES makes Foundation turn that buffering off as the process starts, as Xcode does for
+# the apps it runs. tee and grep --line-buffered pass each line on at once. `scripts/check eval-stream-probe` proves it
+# with a Swift program in place of swift.
 EVAL_STATUS=0
 eval_swift_test() {
     log="$1"; shift
@@ -314,13 +320,63 @@ eval_swift_test() {
     printf '1\n' >"$status_file"
     {
         status=0
-        (cd harness/Evals && "$@" 2>&1) || status=$?
+        (cd harness/Evals && NSUnbufferedIO=YES "$@" 2>&1) || status=$?
         printf '%s\n' "$status" >"$status_file"
     } | tee -a "$log" | grep --line-buffered -E "$EVAL_LINES" || true
     EVAL_STATUS="$(cat "$status_file")"
     return "$EVAL_STATUS"
 }
 
+# eval_stream_probe: proves that eval_swift_test streams and keeps the status, with no model and no real test run. A
+# small Swift program stands in for `swift` on PATH: it prints an eval line through `print` (C stdio, buffered when its
+# output is a pipe, as the test process's is), sleeps two seconds, prints another, and exits with FAKE_STATUS. Run once
+# passing and once failing; each line's arrival is stamped in seconds from the start. The first line must arrive before
+# the second is printed (second 0 or 1), the second at 2 or later, and EVAL_STATUS must be the program's own status.
+eval_stream_probe() {
+    echo "==> eval stream probe (eval_swift_test with a fake swift that prints, sleeps 2 s, prints)"
+    dir="$LOCK_SAVED/stream-probe"
+    mkdir -p "$dir"
+    cat >"$dir/main.swift" <<'EOF'
+import Foundation
+
+print("eval: probe first line")
+Thread.sleep(forTimeInterval: 2)
+print("eval: probe second line")
+exit(Int32(ProcessInfo.processInfo.environment["FAKE_STATUS"] ?? "0") ?? 0)
+EOF
+    xcrun swiftc -o "$dir/swift" "$dir/main.swift"
+    probe_failed=""
+    for want in 0 3; do
+        log="$dir/run-$want.log"
+        : >"$log"
+        start="$(date +%s)"
+        {
+            PATH="$dir:$PATH" FAKE_STATUS="$want" eval_swift_test "$log" env swift test || true
+            printf 'status %s\n' "$EVAL_STATUS"
+        } | while IFS= read -r line; do
+            printf '%s %s\n' "$(($(date +%s) - start))" "$line"
+        done >"$dir/seen-$want"
+        sed "s/^/  fake swift exiting $want: second /" "$dir/seen-$want"
+        first="$(sed -n 's/^\([0-9]*\) eval: probe first line$/\1/p' "$dir/seen-$want")"
+        second="$(sed -n 's/^\([0-9]*\) eval: probe second line$/\1/p' "$dir/seen-$want")"
+        status="$(sed -n 's/^[0-9]* status \([0-9]*\)$/\1/p' "$dir/seen-$want")"
+        if [ -z "$first" ] || [ -z "$second" ] || [ "$first" -gt 1 ] || [ "$second" -lt 2 ]; then
+            echo "eval stream probe: the lines did not arrive as they were printed (first at '$first', second at '$second')" >&2
+            probe_failed=1
+        fi
+        if [ "$status" != "$want" ]; then
+            echo "eval stream probe: EVAL_STATUS was '$status', not the fake swift's own $want" >&2
+            probe_failed=1
+        fi
+        if ! grep -q 'eval: probe second line' "$log"; then
+            echo "eval stream probe: the log lacks the run's output" >&2
+            probe_failed=1
+        fi
+    done
+    if [ -n "$probe_failed" ]; then exit 1; fi
+    echo "eval stream probe: each line arrived as printed, and the status was the command's own"
+}
+
 # The summary of an eval's output: each suite's `eval result` line (EvalModels.result) as a table, a row per model
 # and a column per suite, each cell passed/total and the median time per case; a cell's note below the table.
 eval_summary() {
@@ -713,6 +769,7 @@ case "${1:-all}" in
     coverage-baseline) coverage_baseline ;;
     classifier-default) classifier_default ;;
     eval) shift; eval_ "$@" ;;
+    eval-stream-probe) eval_stream_probe ;;
     mlx-live) shift; mlx_live "$@" ;;
     completions) completions_write ;;
     hygiene) hygiene ;;
@@ -722,5 +779,5 @@ case "${1:-all}" in
     mcp-build) mcp_build ;;
     all) hygiene; palette; lint; build; evals_build; test_ ;;
     install-hooks) install_hooks ;;
-    *) echo "usage: scripts/check [lint|build|evals-build|mlx-build|test|format|coverage|coverage-gate|coverage-baseline|classifier-default|eval [context|compare|checkpoint] [record]|mlx-live <model directory>|completions|mcp-build|hygiene|palette|all|install-hooks]" >&2; exit 64 ;;
+    *) echo "usage: scripts/check [lint|build|evals-build|mlx-build|test|format|coverage|coverage-gate|coverage-baseline|classifier-default|eval [context|compare|checkpoint] [record]|eval-stream-probe|mlx-live <model directory>|completions|mcp-build|hygiene|palette|all|install-hooks]" >&2; exit 64 ;;
 esac

#compdef wisp
# wisp completions: generated from wisp's commands by scripts/check completions; wisp completions install replaces only a file with this line.

__wisp_complete() {
    local -ar non_empty_completions=("${@:#(|:*)}")
    local -ar empty_completions=("${(M)@:#(|:*)}")
    _describe -V '' non_empty_completions -- empty_completions -P $'\'\''
}

__wisp_custom_complete() {
    local -a completions
    completions=("${(@f)"$("${command_name}" "${@}" "${command_line[@]}")"}")
    if [[ "${#completions[@]}" -gt 1 ]]; then
        __wisp_complete "${completions[@]:0:-1}"
    fi
}

__wisp_cursor_index_in_current_word() {
    if [[ -z "${QIPREFIX}${IPREFIX}${PREFIX}" ]]; then
        printf 0
    else
        printf %s "${#${(z)LBUFFER}[-1]}"
    fi
}

_wisp() {
    emulate -RL zsh -G
    setopt extendedglob nullglob numericglobsort
    unsetopt aliases banghist

    local -xr SAP_SHELL=zsh
    local -x SAP_SHELL_VERSION
    SAP_SHELL_VERSION="$(builtin emulate zsh -c 'printf %s "${ZSH_VERSION}"')"
    local -r SAP_SHELL_VERSION

    local context state state_descr line
    local -A opt_args

    local -r command_name="${words[1]}"
    local -ar command_line=("${words[@]}")
    local -ir current_word_index="$((CURRENT - 1))"

    local -i ret=1
    local -ar arg_specs=(
        '--version[Show the version.]'
        '(-h --help)'{-h,--help}'[Show help information.]'
        '(-): :->command'
        '(-)*:: :->arg'
    )
    _arguments -w -s -S : "${arg_specs[@]}" && ret=0
    case "${state}" in
    command)
        local -ar subcommands=(
            'respond:Generate a response to a prompt, calling tools as needed.'
            'chat:Start an interactive chat session.'
            'tools:List the tools available to the model.'
            'models:List, enable, or disable the models usable with --model and config.json, or fetch an MLX model.'
            'mcp:Serve wisp'\''s tools to an MCP client over stdio.'
            'logs:Show the audit log.'
            'config:Show or change the configuration.'
            'doctor:Check that wisp can run on this Mac.'
            'approvals:Show or revoke standing command approvals, and answer commands waiting for approval.'
            'facts:Answer requests to keep a fact as a permanent fact.'
            'notify:Show a macOS notification.'
            'scan:Scan text for credentials and personal data.'
            'redact:Redact credentials and personal data from text.'
            'watch:Rerun a command when files change, and notify when it starts or stops failing.'
            'draft:Draft a commit message, a PR description, or a changelog line from a diff.'
            'classifier:Train, measure, and choose risk classifiers for the approval gate.'
            'completions:Print or install wisp'\''s shell completions for zsh, bash, or fish.'
            'help:Show subcommand help information.'
        )
        _describe -V subcommand subcommands && ret=0
        ;;
    arg)
        case "${words[1]}" in
        respond|chat|tools|models|mcp|logs|config|doctor|approvals|facts|notify|scan|redact|watch|draft|classifier|completions|help)
            "_wisp_${words[1]}" && ret=0
            ;;
        esac
        ;;
    esac

    return "${ret}"
}

_wisp_respond() {
    local -i ret=1
    local -ar arg_specs=(
        ':prompt:'
        '(-i --instructions)'{-i,--instructions}'[Instructions for this conversation, added under wisp'\''s system prompt and config.json'\''s extension.]:instructions:'
        '*--tool[Tool to enable (repeatable). All tools are enabled when omitted.]:tool:{__wisp_custom_complete ---completion respond -- --tool "${current_word_index}" "$(__wisp_cursor_index_in_current_word)"}'
        '--no-tools[Give the model no tools\: a text-only conversation any model can run.]'
        '--unsafe[Disable the run_command policy and sandbox.]'
        '(-m --model)'{-m,--model}'[Model\: system, private-cloud, or <backend>\:<name> (see wisp models). Defaults to config.json.]:model:{__wisp_custom_complete ---completion respond -- --model "${current_word_index}" "$(__wisp_cursor_index_in_current_word)"}'
        '--stream[Stream the output as it is generated.]'
        '--no-stream[Stream the output as it is generated.]'
        '(-y --yes)'{-y,--yes}'[Approve risky commands without asking (non-interactive).]'
        '--schema[Path to a JSON Schema; the reply is JSON of that shape (not streamed).]:schema:'
        '--version[Show the version.]'
        '(-h --help)'{-h,--help}'[Show help information.]'
    )
    _arguments -w -s -S : "${arg_specs[@]}" && ret=0

    return "${ret}"
}

